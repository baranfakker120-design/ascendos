# Lokale Entwicklung: Werte aus `supabase start` (API URL + anon key)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon-key-aus-supabase-start>

# Live Coaching Web Push — PUBLIC key only (safe in client bundle).
# Private key must NEVER be set as VITE_* / never committed.
# VITE_VAPID_PUBLIC_KEY=<url-safe-base64-public-key>

# --- Edge-Function-Secrets (NICHT hier, sondern in supabase/functions/.env
#     bzw. `supabase secrets set`; VITE_-Vars landen im Browser-Bundle!) ---
# VAPID_PUBLIC_KEY=...                  # same public key as VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=...                 # SERVER ONLY — never VITE_
# VAPID_SUBJECT=mailto:you@example.com  # or https://your-app-origin
# CRON_SECRET=...                       # already used by content-daily-prepare
# GEMINI_API_KEY=...                    # einziger KI-Schlüssel (Chat + Embeddings)
# GEMINI_MODEL=gemini-3.5-flash         # optional: Coach-Modell
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite  # optional: Router/Anonymisierung
