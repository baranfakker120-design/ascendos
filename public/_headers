# Cloudflare Pages headers (browser cache control).
# Edge cache invalidation is handled by Cloudflare Pages on each deploy.
# Keep no-cache on SW + manifest so clients pick up new versions.

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate
