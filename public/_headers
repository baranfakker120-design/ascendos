# Cloudflare Pages — browser cache control.
# Edge cache is invalidated by Cloudflare Pages on each deploy.
# Keep HTML + SW + Workbox + manifest no-cache so PWAs pick up new builds.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/workbox-*.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate
